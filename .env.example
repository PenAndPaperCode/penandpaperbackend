# ── Google OAuth ─────────────────────────────────────────────────────────────
# Your Google Cloud Console OAuth 2.0 Client ID
# Same client ID already used in the frontend (LoginButton.tsx)
GOOGLE_CLIENT_ID=339241384511-4srj07ljhqvv75ah1roi185hiqnhomo4.apps.googleusercontent.com

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-strong-random-secret
JWT_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────────────────────
# Set to your frontend domain in production, e.g. https://penpaperpreparation.com
# Use * for development
ALLOWED_ORIGIN=*
